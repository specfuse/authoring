{
  "name": "hello-orders",
  "description": "Bundled example project for the spec-authoring-kit. Exercises the kit's full surface (2 domains, 3 entities, 1 cross-domain scenario, 1 recipe chain) and serves as the kit's CI regression net.",
  "openApiSpecifications": "./output/openapi-bundled.yaml",
  "asyncSpecifications": "./output/asyncapi-bundled.yaml",
  "arazzoSpecifications": "./api/specs/v1",
  "asyncSourceRoot": "./api/specs/v1",
  "dbContextClassname": "HelloOrdersDbContext",
  "stateDir": "./.specfuse/state",
  "groups": [
    {
      "language": "C#",
      "name": "Domain",
      "basePackage": "HelloOrders.Domain",
      "destination": "./out/Backend/",
      "cleanGenerated": true,
      "artifacts": [
        "entity",
        "valueObject",
        "enum"
      ]
    }
  ]
}
