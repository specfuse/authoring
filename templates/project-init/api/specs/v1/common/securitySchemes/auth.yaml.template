# =============================================================================
# Authentication / authorization schemes.
# =============================================================================
# See API Handbook §5. Replace iss/aud with the project's actual identity
# provider URIs. The role enum is defined in common/enums.yaml#/Role.

bearerAuth:
  type: http
  scheme: bearer
  bearerFormat: JWT
  description: |
    Bearer JWT (RS256) issued by the project's identity provider.
    The token's claims namespace is project-specific; map roles to the
    Role enum (api/specs/v1/common/enums.yaml#/Role) at the gateway or
    auth middleware layer.
