# =============================================================================
# Standard error responses.
# =============================================================================
# Reference these from operation files via $ref. See API Handbook §2 and §11.

# Every shape here that lands in components.schemas declares `x-domain: common`:
# generator 0.13.0 requires a domain on every non-entity schema
# (SCHEMA_DOMAIN_REQUIRED, ERROR), and `common` is the reserved shared value.
Error:
  type: object
  x-domain: common
  required: [code, message]
  properties:
    # Not `format: uuid`: the generated C# exceptions fill `id` with a string of
    # their own, and a uuid-typed `Id` does not compile (CS0029).
    id:
      type: string
      description: >-
        Unique identifier for this error instance, for support correlation.
        Opaque: clients must not parse it.
    type:
      allOf:
        - $ref: '#/ErrorType'
      description: Broad category of the failure. See ErrorType.
    code:
      type: integer
      description: >-
        HTTP status of the response carrying this error (400, 409, …). The
        rule that failed is named by `reason`, not here.
      example: 409
    reason:
      type: string
      maxLength: 64
      pattern: '^[a-z][a-z0-9_]*$'
      description: >-
        Stable snake_case name of the rule that failed (`template_in_use`,
        `invalid_page_size`). Clients branch on this, never on `message`.
        Absent when the error has no rule-level identity, such as a plain
        schema violation.
      example: template_in_use
    message:
      type: string
      description: Human-readable error message (localized via Accept-Language)
    field:
      type: string
      description: Field name that caused the error (for validation errors)
    retryable:
      type: boolean
      description: Whether this error can be retried
    retryAfter:
      type: integer
      description: Seconds to wait before retrying (if retryable)
    # Same case as `currentResource` below, and declared the same way: an error
    # payload's extra context differs per error, so no `$ref` can name it. The
    # generator refuses an anonymous `type: object`, so state the openness.
    details:
      type: object
      additionalProperties: true
      description: >-
        Additional context-specific error details. Free-form by nature —
        clients must not depend on any particular key being present.
    requestId:
      type: string
      description: Request ID for correlation
    timestamp:
      type: string
      format: date-time

# `type` is required by the C# `domainExceptions` artifact: the generator refuses
# to generate it (ARTIFACT_SCHEMA_DEPENDENCY) unless `Error.type` is typed by an
# `ErrorType` enum carrying at least these eight values. Open set
# (`x-extensible`): a client built before a new type ships must still decode
# the error body, and falls back to the HTTP status. API Handbook §11.
ErrorType:
  type: string
  x-domain: common
  x-extensible: true
  enum:
    - validationError
    - invalidToken
    - insufficientPrivileges
    - resourceNotFound
    - resourceConflict
    - preconditionFailed
    - businessRuleViolation
    - internalError

UnauthorizedError:
  description: The authentication token is missing or expired
  headers:
    WWW-Authenticate:
      schema: { type: string }
  content:
    application/json:
      schema:
        $ref: '#/Error'

ForbiddenError:
  description: >
    The caller is authenticated but lacks the required role/scope/tenant context
    for this endpoint.
  content:
    application/json:
      schema:
        $ref: '#/Error'

NotFoundError:
  description: The requested resource does not exist
  content:
    application/json:
      schema:
        $ref: '#/Error'

BadRequestError:
  description: The request body or parameters failed validation
  content:
    application/json:
      schema:
        type: array
        items:
          $ref: '#/Error'

UnsupportedMediaTypeError:
  description: >
    The request body's Content-Type is not supported by this operation. Declared
    on every operation that accepts a request body (API Handbook §2). Added when
    specfuse-415-when-request-body went live — see authoring #73.
  content:
    application/json:
      schema:
        $ref: '#/Error'

ConflictError:
  description: >
    Business rule violation prevents the operation (NOT for concurrency control —
    see PreconditionFailedError for ETag mismatches). See API Handbook §2.1.
  content:
    application/json:
      schema:
        $ref: '#/Error'

# The 412 body is a named schema rather than an inline one: the generator
# rejects inline response schemas (INLINE_RESPONSE_SCHEMA), because a response
# shape with no name cannot be generated into a typed DTO.
PreconditionFailedBody:
  type: object
  x-domain: common
  properties:
    errors:
      type: array
      items:
        $ref: '#/Error'
    # The one sanctioned open map in the contract, and it is declared as one
    # rather than left anonymous. The 412 body is shared by every endpoint, so
    # this field is a different entity on each — there is no `$ref` that could
    # name it. An undeclared `type: object` is the generator's
    # ANONYMOUS_OBJECT_PLACEHOLDER error, and rightly: an untyped inline object
    # cannot be modelled, so `additionalProperties` states the intent instead of
    # leaving it to be inferred.
    #
    # It does NOT weaken the open-map ban that governs event payloads
    # (AsyncAPI_Handbook.md §"closed universe"). That ban exists because an
    # open map hides fields from typing, from the version cascade, and from the
    # PII/classification rules. None of those bite here: this echoes a resource
    # the caller already holds an ETag for — so it discloses nothing new — and
    # it is an error body, not a payload anything downstream consumes by shape.
    currentResource:
      description: >-
        Current state of the resource, echoed so an AI agent can merge and
        retry without a second round-trip. Shape is the endpoint's own
        resource; optional, and a client must be able to proceed without it.
      type: object
      additionalProperties: true

PreconditionFailedError:
  description: >
    The `If-Match` ETag did not match the resource's current state.
    Response includes the current resource for AI-agent merge-and-retry.
  headers:
    ETag:
      schema: { type: string }
  content:
    application/json:
      schema:
        $ref: '#/PreconditionFailedBody'
