# =============================================================================
# Project enums shared across OpenAPI operations.
# =============================================================================
# Add domain-specific enums here as needed.
#
# The project's closed ROLE set does NOT live here. It is the `info.x-roles`
# registry in openapi.yaml — that is what operation `x-roles` values are
# validated against (OPERATION_UNKNOWN_ROLE, ERROR). A `Role` enum in this file
# is validated against nothing, and if no property is typed by it the generator
# reports it as SCHEMA_UNREFERENCED dead code. See Vendor_Extensions.md §3.1.
#
# Declare an enum here when a PROPERTY needs the type — as CurrencyCode does
# below. If some property really is role-typed, keep that enum in step with
# `info.x-roles` by hand; they are two declarations of one vocabulary.

# -----------------------------------------------------------------------------
# CurrencyCode — ISO 4217 codes preserved exactly.
# -----------------------------------------------------------------------------
# Replace with the currencies the project actually supports.
CurrencyCode:
  type: string
  x-enum-case: preserve     # ISO codes must not be re-cased by the generator
  enum:
    - USD
    - EUR
    - GBP
